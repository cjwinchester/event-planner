{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Conference schedule schema",
  "description": "Schema for a conference schedule JSON used by the build and runtime. Reflects the current source format generated by the app script.",
  "type": "object",
  "required": ["sessions"],
  "properties": {
    "conference": { "type": "string", "description": "human-friendly conference name" },
    "name": { "type": "string", "description": "legacy alias for conference" },
    "title": { "type": "string", "description": "alternate title (optional)" },
    "slug": {
      "type": "string",
      "description": "legacy: short slug used in URLs and cache names. Not present in the current source format; the runtime slug comes from the deployed conference's DATA_URL/build config instead."
    },
    "splash_page_intro_text": {
      "type": "string",
      "description": "Intro copy shown at the top of the splash page, above the section buttons. Rendered as plain text; paired with a 'Read more' link to url_conference_details when that is present."
    },
    "description": {
      "type": "string",
      "description": "legacy alias for splash_page_intro_text"
    },
    "start_date": { "type": "string" },
    "end_date": { "type": "string" },
    "virtual": { "type": "boolean", "description": "true if the conference is fully virtual" },
    "location": {
      "type": "object",
      "description": "Structured venue details for in-person conferences. Supersedes the flat conf_city/hotel_* fields, which no longer appear in current feeds. Every property is present but empty for virtual conferences, so check for non-empty values rather than for the key.",
      "properties": {
        "venue_name": { "type": "string" },
        "venue_address": { "type": "string", "description": "street address line" },
        "venue_city": { "type": "string" },
        "venue_state": { "type": "string" },
        "venue_postal_code": { "type": "string" },
        "venue_gmaps_link": { "type": "string", "description": "URL to the venue on Google Maps" }
      },
      "additionalProperties": true
    },
    "conf_city": {
      "type": "string",
      "description": "legacy: conference city. Replaced by location.venue_city."
    },
    "timezone_short": {
      "type": "string",
      "description": "legacy/deprecated: short human-friendly timezone label (e.g. 'ET', 'PT'). The runtime now derives this display label from `timezone` instead of trusting this field, since a static label can't reflect DST."
    },
    "timezone": {
      "type": "string",
      "description": "IANA timezone identifier (e.g. 'America/New_York'), sourced from SpreadsheetApp.getSpreadsheetTimeZone(). Single source of truth for both date/time math and the display label shown to attendees."
    },
    "updated": {
      "type": "string",
      "description": "ISO date/time when the schedule was last updated"
    },
    "hotel_name": { "type": "string", "description": "legacy: replaced by location.venue_name" },
    "banner_image": { "type": "string" },
    "hotel_address": {
      "type": "string",
      "description": "legacy: replaced by location.venue_address"
    },
    "hotel_gmaps_link": {
      "type": "string",
      "description": "legacy: replaced by location.venue_gmaps_link"
    },
    "registration_link": { "type": "string", "description": "legacy alias for url_registration" },
    "url_registration": { "type": "string", "description": "link to conference registration" },
    "url_conference_details": {
      "type": "string",
      "description": "link to the public conference details page"
    },
    "schedule_formats": {
      "type": "object",
      "description": "map of alternate schedule file format (e.g. online, txt, csv, json, pdf) to its URL, generated by the app script",
      "additionalProperties": { "type": "string" }
    },
    "sessions": {
      "type": "array",
      "items": { "$ref": "#/definitions/session" },
      "description": "list of sessions / talks / panels"
    },
    "speakers": {
      "type": "array",
      "items": { "$ref": "#/definitions/speaker" },
      "description": "speaker objects referenced by sessions (optional)"
    },
    "sponsors": {
      "type": "array",
      "items": { "$ref": "#/definitions/sponsor" },
      "description": "legacy/optional: top-level sponsors with ids and metadata"
    },
    "rooms": {
      "type": "object",
      "description": "legacy/optional: map of room name to metadata (level, os)",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "level": {
            "type": ["integer", "string"],
            "description": "floor/level number or empty string for unknown"
          },
          "os": { "type": "string" }
        },
        "additionalProperties": false
      }
    },

    "meta_events": {
      "type": "object",
      "description": "legacy/optional: map of ISO date string to an array of meta/logistical events for that day",
      "additionalProperties": {
        "type": "array",
        "items": { "$ref": "#/definitions/meta_event" }
      }
    },
    "exhibitors": {
      "type": "array",
      "items": { "$ref": "#/definitions/exhibitor" },
      "description": "legacy/optional: exhibitor objects with id and metadata"
    },
    "tracks": {
      "oneOf": [
        { "type": "array", "items": { "type": "string" } },
        {
          "type": "object",
          "description": "map of track name to metadata or a simple flag",
          "additionalProperties": {
            "oneOf": [{ "type": "object" }, { "type": "boolean" }, { "type": "string" }]
          }
        }
      ]
    },
    "exhibitor_location": {
      "type": "string",
      "description": "legacy/optional: location of the exhibitor hall"
    },
    "additional_links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": { "type": "string" },
          "url": { "type": "string" }
        },
        "required": ["label", "url"]
      },
      "description": "list of additional resource links to display on the splash page"
    },
    "floorplans": {
      "type": "array",
      "items": { "$ref": "#/definitions/floorplan" },
      "description": "legacy/optional: list of hotel floorplan images, one per floor",
      "default": []
    }
  },
  "definitions": {
    "session": {
      "type": "object",
      "required": ["session_id", "session_title", "start_time", "end_time"],
      "properties": {
        "session_id": { "type": ["string", "integer"] },
        "session_title": { "type": "string" },
        "id": { "type": ["string", "integer"], "description": "legacy alias for session_id" },
        "title": { "type": "string", "description": "legacy alias for session_title" },
        "description": { "type": "string" },
        "summary": { "type": "string" },
        "start_time": { "type": "string" },
        "end_time": { "type": "string" },
        "duration": { "type": "integer", "description": "session length in minutes" },
        "skill_level": { "type": "string" },
        "speaker_ids": {
          "type": "array",
          "items": { "type": ["string", "integer"] },
          "description": "array of speaker ids"
        },
        "speakers": {
          "type": ["array", "string"],
          "items": { "type": ["string", "integer"] },
          "description": "legacy alias for speaker_ids; some feeds now emit this as a free-text credit line (e.g. \"Jane Doe, Outlet; John Smith, Outlet\") rather than an array — speaker_ids is authoritative when present"
        },
        "tracks": {
          "type": "array",
          "items": { "type": "string" },
          "description": "array of track names"
        },
        "cost": {
          "type": "string",
          "description": "legacy/optional cost represented as a string (e.g. \"50\", \"Free\", or \"TBD\")"
        },
        "sponsored_by": { "type": "string", "description": "legacy/optional: sponsor id (string)" },
        "track": { "type": "string", "description": "legacy alias, singular" },
        "room": { "type": "string" },
        "session_type": { "type": "string" },
        "type": { "type": "string", "description": "legacy alias for session_type" },
        "tags": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "speaker": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": ["string", "integer"] },
        "first_name": { "type": "string" },
        "last_name": { "type": "string" },
        "name": { "type": "string" },
        "bio": { "type": "string" },
        "affiliation": { "type": "string" },
        "headshot": { "type": "string", "description": "URL to headshot image" },
        "session_ids": {
          "type": "array",
          "items": { "type": ["string", "integer"] },
          "description": "array of session ids this speaker appears in"
        },
        "connect": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": { "type": "string" },
              "url": { "type": "string" }
            },
            "additionalProperties": true
          },
          "description": "array of social/link objects (label + url)"
        },
        "links": {
          "type": "array",
          "items": { "type": "object", "additionalProperties": { "type": "string" } },
          "description": "legacy alias for connect"
        },
        "social": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": { "type": "string" },
              "url": { "type": "string" }
            },
            "additionalProperties": true
          },
          "description": "legacy alias for connect"
        }
      },
      "additionalProperties": true
    },
    "sponsor": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "logo_image_url": { "type": "string" },
        "sponsor_level": { "type": "string" },
        "url": { "type": "string" }
      },
      "additionalProperties": true
    },
    "exhibitor": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "logo_image_url": { "type": "string" },
        "url": { "type": "string" }
      },
      "additionalProperties": true
    },
    "meta_event": {
      "type": "object",
      "properties": {
        "datetime_start": { "type": "string" },
        "datetime_end": { "type": "string" },
        "date": { "type": "string" },
        "type": { "type": "string" },
        "room": { "type": ["string", "integer"] },
        "description": { "type": "string" }
      },
      "additionalProperties": true
    },
    "floorplan": {
      "type": "object",
      "required": ["floor", "image_url"],
      "properties": {
        "floor": {
          "type": ["integer", "string"],
          "description": "Floor number or label (e.g. 1, 2, 'Lobby')"
        },
        "image_url": {
          "type": "string",
          "description": "URL to the floorplan image"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
