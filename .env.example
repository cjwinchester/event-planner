# Copy to .env and adjust. Every setting is read in config/settings/base.py.

# --- Core ---
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

# PostGIS is required. postgis:// selects the GeoDjango backend.
DATABASE_URL=postgis://postgres:postgres@localhost:5432/event_planner

# macOS/Homebrew, only if Django can't find GDAL/GEOS on its own:
# GDAL_LIBRARY_PATH=/opt/homebrew/lib/libgdal.dylib
# GEOS_LIBRARY_PATH=/opt/homebrew/lib/libgeos_c.dylib

# Fernet keys for encrypting integration credentials at rest. Generate with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Comma-separate several keys to rotate (first one encrypts).
FIELD_ENCRYPTION_KEYS=

# --- Google Workspace SSO (allauth) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Media storage (leave blank to use local disk) ---
AWS_STORAGE_BUCKET_NAME=
AWS_PRIVATE_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY are read by boto3 directly.

# --- Background tasks ---
# Default is the Postgres-backed queue; run `manage.py db_worker`.
# TASKS_BACKEND=django_tasks_db.DatabaseBackend
